# Copy to .env and replace both values before starting.
POSTGRES_USER=postgres
POSTGRES_DB=interior_design
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
SECRET_KEY=replace-with-a-generated-secret-key
# Set to true only when using HTTPS (including a forwarded Codespaces URL).
COOKIE_SECURE=false
PROFILE_DEVELOPMENT_PREVIEW=false
