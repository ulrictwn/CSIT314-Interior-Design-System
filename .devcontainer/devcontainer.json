{
  "name": "Interior Design Development",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/interior-design",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "postCreateCommand": "python -m venv --clear .venv && .venv/bin/python -m pip install -r requirements.txt",
  "features": {
  "ghcr.io/devcontainers/features/git-lfs:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}